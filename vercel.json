{
  "version": 2,
  "builds": [
    { "src": "api.py", "use": "@vercel/python" },
    { "src": "public.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api.py" },
    { "src": "/style.css", "dest": "style.css" },
    { "src": "/script.js", "dest": "script.js" },
    { "src": "/(.*)", "dest": "public.html" }
  ]
}
